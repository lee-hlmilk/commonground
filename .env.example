# Copy to .env and insert both provider keys. Never expose keys to the browser.
# Jev is primary; Claude handles individual responses below Jev's threshold.
DECISION_PROVIDER=jev

# Claude low-confidence fallback (or standalone with DECISION_PROVIDER=claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TIMEOUT_SECONDS=25
ANTHROPIC_MAX_RETRIES=1

# Primary: fill the TypeSafe key below.
# Jev returns typed decisions; the app labels its rendered messages as templates.
JEV_API_KEY=
# TYPESAFE_API_KEY is accepted as an alternative name for JEV_API_KEY.
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=25
JEV_MAX_RETRIES=1
# Application decision threshold, not a validated aviation safety margin.
JEV_MIN_CONFIDENCE=0.7

FLIGHTS_CSV=./flights.csv
AIRPORTS_CSV=./airports.csv
AIRLINES_CSV=./airlines.csv
DATABASE_PATH=./data/coordination.sqlite3
DEFAULT_SCENARIO=atl-three-flight-clash

NEGOTIATION_MAX_ROUNDS=3
NEGOTIATION_DEADLINE_SECONDS=120

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
